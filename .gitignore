.DS_Store
Thumbs.db
db.json
*.log
node_modules/
public/
.deploy*/
_multiconfig.yml
.idea/
.claude/

# Theme symlink/junction - local only; re-create via setup script
/themes/notebook

# Rephrase source material that is not published
raw/

# Generated rephrase/notes site content (recreated by scripts/import-rephrase.js)
source/_posts/Rephrase/
source/rephrase/
source/notes/
source/_data/rephrase.json

# Generated coach site content (recreated by tools/import-coach.js)
source/_posts/Coach/
source/coach/
source/_data/coach.json

# Generated chat site content (recreated by tools/import-chat.js)
source/_posts/Chat/
source/chat/
source/_data/chat.json

# Generated pattern-drill site content (recreated by tools/import-patterns.js)
source/_posts/Patterns/
source/patterns/
source/_data/patterns.json

# Generated form-drill site content (recreated by tools/import-form-drills.js)
source/_posts/Form/
source/form/
source/_data/form.json

# Generated learning hub (recreated by tools/import-learning.js, runs last).
# It writes the site's front page, so source/index.md is generated too.
source/index.md
source/learning/
source/_data/learning.json

# Raw dropped material
coach/inbox/

# Python bytecode from skill scripts
__pycache__/
*.pyc

# Generated qa site content (recreated by tools/import-qa.js)
source/qa/
source/_data/qa.json

# Juyouci vocab decks: no importer regenerates these pages.
# Root juyouci/ is the source-of-truth archive (master standalone HTML, audit
# reports and CSV). source/juyouci/ is the hand-maintained published hub and
# standalone deck pages; both must stay tracked. The negations below defend
# against a future broad source/ ignore rule, since other source/ subtrees are
# generated by importers and ignored above.
!source/juyouci/
!source/juyouci/**

# Local scratch left inside a deck folder (intermediate drafts, temp copies)
juyouci/**/*.tmp
juyouci/**/*.bak
